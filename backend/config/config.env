NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/akawo_platform

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

PAYMENT_GATEWAY_API=https://api.paystack.co
PAYMENT_GATEWAY_SECRET_KEY=your_paystack_secret_key_here

FACIAL_RECOGNITION_API=https://api.facialrecognition.com
FACIAL_RECOGNITION_API_KEY=your_facial_recognition_api_key_here

LIVENESS_VERIFICATION_API=https://api.livenessverification.com
