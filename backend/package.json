{
  "name": "akawo-platform-backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers backend for the Akawo Platform (D1 + R2 + Paystack)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute akawo-db --local --file=./migrations/0001_schema.sql",
    "db:init:remote": "wrangler d1 execute akawo-db --remote --file=./migrations/0001_schema.sql",
    "db:create": "wrangler d1 create akawo-db"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}
